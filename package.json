{
  "name": "@cortexkit/openai-auth",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "build": "bun scripts/check-installed-ranges.mjs && bun scripts/check-local-deps.mjs && cd packages/core && bun run build && cd ../opencode && bun run build && cd ../pi && bun run build",
    "build:arcus": "bun run build && bash scripts/pack-all-arcus.sh",
    "package:arcus": "bash scripts/pack-all-arcus.sh",
    "pack:arcus": "bash scripts/pack-all-arcus.sh",
    "pack:opencode": "bash scripts/pack-opencode-arcus.sh",
    "pack:pi": "bash scripts/pack-pi-arcus.sh",
    "sign:arcus": "bash scripts/sign-arcus.sh",
    "validate:arcus": "bash scripts/validate-arcus.sh",
    "publish:arcus": "bash scripts/publish-all-arcus.sh",
    "publish:suite": "bash scripts/publish-all-arcus.sh",
    "migrate:arcus": "bash scripts/migrate-arcus.sh",
    "pipeline:arcus": "bash scripts/arcus-pipeline.sh",
    "fork-sync": "bash scripts/fork-sync.sh",
    "sync:fork": "bash scripts/fork-sync.sh",
    "dev": "bun scripts/dev.ts",
    "dev:clean": "bun scripts/dev-clean.ts",
    "analyze:cache": "bun scripts/analyze-cache-cliffs.mjs",
    "test": "cd packages/core && bun run test && cd ../opencode && bun run test && cd ../pi && bun run test",
    "typecheck": "cd packages/core && bun run typecheck && cd ../opencode && bun run typecheck && cd ../pi && bun run typecheck",
    "types": "bun run typecheck",
    "format": "biome check --write --unsafe .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "check:ranges": "bun scripts/check-installed-ranges.mjs",
    "check:local-deps": "bun scripts/check-local-deps.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cortexkit/openai-auth-core": "workspace:*",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@opencode-ai/plugin": "1.18.34",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "bun-types": "1.4.2",
    "lefthook": "2.1.16",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
