# Standing conflict classes for openai-auth fork sync
# Format: <action>: <glob>
#
# keep-deleted: files removed in this fork that upstream might re-introduce
# take-theirs: pure checkout — upstream's version is always preferred as-is
# regenerate:  checkout upstream's version, run the rebuild command for THAT
#              FILE'S ecosystem, then stage the result INTO the merge commit
#              (never a follow-up commit)
#
# `regenerate` dispatches on the matched file's BASENAME, not on the glob that
# matched it, so one rule can cover several ecosystems in a polyglot fork. An
# unrecognized basename is a hard error: the sync refuses to guess a rebuild
# command and leaves the conflict intact for manual review.

# Arcus packaging outputs and transient local directories
keep-deleted: dist-arcus/*

# Upstream GitHub workflows, issue templates, and publish scripts replaced by uc-studio/Arcus packaging
keep-deleted: .github/workflows/*
keep-deleted: .github/ISSUE_TEMPLATE/*
keep-deleted: .github/dependabot.yml
keep-deleted: scripts/release.sh
keep-deleted: scripts/version-sync.mjs
keep-deleted: scripts/wait-release.sh

# Lockfile. `take-theirs` alone is wrong here: upstream's lockfile does not
# describe this fork's devDependency set (@earendil-works/*, lefthook, our
# pinned @opencode-ai/plugin), so it must be rebuilt against the merged
# package.json rather than adopted verbatim.
regenerate: bun.lock
