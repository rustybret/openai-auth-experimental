# Standing conflict classes for openai-auth fork sync
# Format: <action>: <glob>
#
# keep-deleted: files removed in this fork that upstream might re-introduce
# take-theirs: regenerable files where upstream's version is always preferred
# regenerate:  take upstream's copy, then rebuild it from the merged manifests
#              and stage the result INSIDE the merge commit

# Arcus packaging outputs and transient local directories
keep-deleted: dist-arcus/*

# Lockfile. `take-theirs` alone is wrong here: upstream's bun.lock does not
# describe this fork's devDependency set (@earendil-works/*, lefthook, our
# pinned @opencode-ai/plugin), so it must be regenerated against the merged
# package.json rather than adopted verbatim.
regenerate: bun.lock
